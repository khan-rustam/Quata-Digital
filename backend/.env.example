# --- Core ---
ENVIRONMENT=production
PROJECT_NAME="QUATA Digital API"
API_PREFIX=/api/v1
# Public origin where /uploads/... will be served from.
PUBLIC_BASE_URL=https://quatadigital.com

# Public origin of the marketing site (used in password-reset emails, etc.)
FRONTEND_URL=https://quatadigital.com

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-very-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# Default: SQLite (zero config for dev). Swap to Postgres in prod.
DATABASE_URL=sqlite:///./quata.db
# DATABASE_URL=postgresql+psycopg://quata:strong-password@localhost:5432/quata

# --- Schema management ---
# Dev: AUTO_CREATE_TABLES=true creates missing tables on boot.
# Prod: set to false and run `alembic upgrade head` instead.
AUTO_CREATE_TABLES=true

# --- CORS ---
BACKEND_CORS_ORIGINS=["https://quatadigital.com","https://www.quatadigital.com","https://2025quata.quatadigital.com","http://localhost:3000"]

# --- Seeding ---
# Set SEED_ON_STARTUP=false after first deploy.
SEED_ON_STARTUP=true
DEFAULT_ADMIN_EMAIL=admin@quatadigital.com
DEFAULT_ADMIN_PASSWORD=ChangeMe!2026

# --- File uploads (local disk on the VPS) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Email (production: SMTP2GO) ---
# console: prints to stdout (dev). smtp: real send. disabled: silent.
EMAIL_BACKEND=smtp
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="QUATA Digital <noreply@quatadigital.com>"
# Comma-separated internal recipients for partner submissions, contact forms, etc.
EMAIL_NOTIFY_TO=info@quatadigital.com

# --- i18n ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en"]

# --- Account security ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10

# --- 2FA ---
TOTP_ISSUER="QUATA Digital"

# --- Rate limits ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PUBLIC_FORM=20/minute
RATE_LIMIT_PASSWORD_RESET=5/hour

# --- Device webhook HMAC (set true to enforce in addition to per-device token) ---
DEVICE_REQUIRE_SIGNATURE=false
DEVICE_HMAC_HEADER=X-Device-Signature
DEVICE_HMAC_TIMESTAMP_HEADER=X-Device-Timestamp
DEVICE_HMAC_SKEW_SECONDS=300

# --- QUATA Notification Service (@QuataAlertsBot) ---
# The ONE place that talks to Telegram. Every QUATA platform publishes
# events here; no platform ships its own bot. See docs/NOTIFICATIONS.md.
# Bot token from @BotFather for the EXISTING @QuataAlertsBot — do not create
# a new bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Bootstrap recipients (comma-separated). Only read on first boot to seed the
# recipients table; manage them in /admin/alerts afterwards. Find the ids with
#   python -m app.scripts.telegram_chats
# CHAT_IDS = where alerts go, typically the ops group (negative id).
# ADMIN_USER_IDS = individual administrators' private chats (positive ids).
TELEGRAM_DEFAULT_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=
# Master kill-switch. false = record events but never dispatch.
NOTIFY_ENABLED=true
NOTIFY_TIMEOUT_SECONDS=10
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_DEDUPE_WINDOW_SECONDS=300
# 💰 LARGE TRANSACTION ALERT threshold (XAF). Editable in the admin.
NOTIFY_LARGE_TX_THRESHOLD=1000000
# Ingest credentials for the other platforms, as platform:key pairs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTIFY_INGEST_KEYS=["quatapay:...","quatafood:...","abaqwa:...","quatatrade:...","quata_ai:..."]
NOTIFY_INGEST_KEYS=[]
# Require an HMAC signature header on top of the ingest key. Recommended.
NOTIFY_REQUIRE_SIGNATURE=false
NOTIFY_SIGNATURE_SKEW_SECONDS=300
NOTIFICATION_LOG_RETENTION_DAYS=180
# Absolute URL the notification worker probes to catch an API outage the app
# can't report itself (crash, OOM kill, hung worker). Must point at the API
# host, not the website. Empty = watchdog off.
# NOTIFY_HEALTHCHECK_URL=https://api.quatadigital.com/health/ready
NOTIFY_HEALTHCHECK_URL=

# --- Observability ---
# SENTRY_DSN=https://...
# SENTRY_ENV=production
LOG_FORMAT=json
